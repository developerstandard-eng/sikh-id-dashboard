# Points the dashboard at your central Sikh ID API (see vps-backend)
NEXT_PUBLIC_API_BASE_URL=https://auth.thesikhgroup.com

# Server-only (no NEXT_PUBLIC_ prefix — never reaches the browser bundle).
# Used by src/app/api/login/route.ts to authenticate the standalone test-login
# form against the backend's site-secret-protected /auth/login endpoint.
# Must match SITE_SHARED_SECRET in vps-backend/.env and one entry in its
# ALLOWED_SITE_DOMAINS.
SITE_SHARED_SECRET=
SITE_DOMAIN=fastlinkinc.com
